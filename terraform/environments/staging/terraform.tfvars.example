environment              = "staging"
aws_region               = "us-east-1"
availability_zones       = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr                 = "10.20.0.0/16"
public_subnet_cidrs      = ["10.20.0.0/24", "10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs     = ["10.20.16.0/20", "10.20.32.0/20", "10.20.48.0/20"]
single_nat_gateway       = false
domain_name              = "staging.rag.example.com"
hosted_zone_id           = "Z0000000000000000000"
github_repository        = "your-org/production-rag-knowledge-platform"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
state_bucket_arn         = "arn:aws:s3:::replace-with-state-bucket"
state_kms_key_arn        = "arn:aws:kms:us-east-1:123456789012:key/replace-me"
alert_email_addresses    = ["platform@example.com"]
general_desired_size     = 2
qdrant_desired_size      = 3
gpu_desired_size         = 0
aurora_instance_class    = "db.r6g.large"
aurora_instance_count    = 2
deletion_protection      = true
