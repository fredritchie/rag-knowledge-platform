environment              = "staging"
aws_region               = "ap-south-1"
availability_zones       = ["ap-south-1a", "ap-south-1b", "ap-south-1c"]
vpc_cidr                 = "10.20.0.0/16"
public_subnet_cidrs      = ["10.20.0.0/24", "10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs     = ["10.20.16.0/20", "10.20.32.0/20", "10.20.48.0/20"]
single_nat_gateway       = false
enable_https             = true
domain_name              = "fred-rag-stage.duckdns.org"
hosted_zone_id           = null
certificate_arn          = "arn:aws:acm:ap-south-1:123456789012:certificate/replace-with-duckdns-certificate"
enable_duckdns           = true
github_repository        = "your-org/production-rag-knowledge-platform"
# Set this when GitHub immutable OIDC subjects are enabled, using the repository API's sub_claim_prefix.
github_oidc_subject_prefix = null
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
state_bucket_arn         = "arn:aws:s3:::replace-with-state-bucket"
state_kms_key_arn        = "arn:aws:kms:ap-south-1:123456789012:key/replace-me"
alert_email_addresses    = ["platform@example.com"]
general_desired_size     = 2
qdrant_desired_size      = 3
ingestion_desired_size   = 2
gpu_desired_size         = 0
aurora_instance_class    = "db.r6g.large"
aurora_instance_count    = 2
deletion_protection      = true
drive_secret_arns        = []
