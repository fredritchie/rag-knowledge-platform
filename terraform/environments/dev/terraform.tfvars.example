environment              = "dev"
aws_region               = "us-east-1"
availability_zones       = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr                 = "10.10.0.0/16"
public_subnet_cidrs      = ["10.10.0.0/24", "10.10.1.0/24", "10.10.2.0/24"]
private_subnet_cidrs     = ["10.10.16.0/20", "10.10.32.0/20", "10.10.48.0/20"]
single_nat_gateway       = true
enable_https             = false
domain_name              = null
hosted_zone_id           = null
github_repository        = "your-org/production-rag-knowledge-platform"
# Set this when GitHub immutable OIDC subjects are enabled, using the repository API's sub_claim_prefix.
github_oidc_subject_prefix = null
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
state_bucket_arn         = "arn:aws:s3:::replace-with-state-bucket"
state_kms_key_arn        = "arn:aws:kms:us-east-1:123456789012:key/replace-me"
alert_email_addresses    = ["platform@example.com"]
general_desired_size     = 1
qdrant_desired_size      = 1
gpu_desired_size         = 0
aurora_instance_class    = "db.t4g.medium"
aurora_instance_count    = 1
deletion_protection      = false
