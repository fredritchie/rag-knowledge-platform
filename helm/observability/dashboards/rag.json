    {"id": 7, "title": "Generated tokens / sec", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}, "targets": [{"refId": "A", "expr": "sum by (model) (rate(rag_generated_tokens_total[5m]))", "legendFormat": "{{model}}"}]},
