{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {"id": 1, "title": "SQS queue depth", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "cloudwatch", "uid": "CloudWatch"}, "targets": [{"refId": "A", "namespace": "AWS/SQS", "metricName": "ApproximateNumberOfMessagesVisible", "dimensions": {"QueueName": "$queue"}, "statistic": "Average", "region": "default"}]},
    {"id": 2, "title": "Oldest message age", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "fieldConfig": {"defaults": {"unit": "s"}}, "datasource": {"type": "cloudwatch", "uid": "CloudWatch"}, "targets": [{"refId": "A", "namespace": "AWS/SQS", "metricName": "ApproximateAgeOfOldestMessage", "dimensions": {"QueueName": "$queue"}, "statistic": "Maximum", "region": "default"}]},
    {"id": 3, "title": "DLQ depth", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "cloudwatch", "uid": "CloudWatch"}, "targets": [{"refId": "A", "namespace": "AWS/SQS", "metricName": "ApproximateNumberOfMessagesVisible", "dimensions": {"QueueName": "$dlq"}, "statistic": "Maximum", "region": "default"}]},
    {"id": 4, "title": "Documents / min", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "targets": [{"refId": "A", "expr": "sum(rate(rag_ingestion_documents_total{outcome=\"succeeded\"}[5m])) * 60"}]},
    {"id": 5, "title": "Failed ingestion", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "targets": [{"refId": "A", "expr": "sum(increase(rag_ingestion_documents_total{outcome=\"failed\"}[15m]))"}]},
    {"id": 6, "title": "Drive lag", "type": "timeseries", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "time() - max(rag_drive_sync_last_success_unixtime)"}]}
  ],
  "refresh": "30s",
