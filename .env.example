RAG_DATA_DIR=.rag_data
RAG_CONFIG=config/rag.yaml
# Any YAML value can be overridden with RAG__SECTION__KEY.
RAG__TENANT_ID=default
RAG__CHUNKING__SIZE=500
RAG__CHUNKING__OVERLAP=75
RAG__EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
RAG__RETRIEVAL__TOP_K=5
RAG__RETRIEVAL__SIMILARITY_THRESHOLD=0.65
RAG__QDRANT__URL=http://localhost:6333
RAG__GENERATION__BASE_URL=http://localhost:11434
RAG__GENERATION__MODEL=llama3.2:3b
RAG__DATABASE__URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_platform
RAG__AUTH__ISSUER=https://cognito-idp.us-east-1.amazonaws.com/replace-me
RAG__AUTH__AUDIENCE=replace-me-client-id
RAG__STORAGE__BUCKET=replace-me-rag-documents
RAG__EVENT_INGESTION__ENABLED=false
RAG__EVENT_INGESTION__QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/rag-ingestion
RAG__EVENT_INGESTION__DLQ_URL=https://sqs.us-east-1.amazonaws.com/000000000000/rag-ingestion-dlq
RAG__EVENT_INGESTION__VISIBILITY_TIMEOUT_SECONDS=900
RAG__DRIVE__ENABLED=false
RAG__DRIVE__SYNC_INTERVAL_SECONDS=300
